# ==============================================================================
# Open Workers — Environment Configuration Template
# Copy this file to `.env` and fill in your values. Never commit `.env` or `.pem`.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins (defaults to APP_URL if omitted)
ALLOWED_ORIGINS=http://localhost:3000

# GitHub App Credentials (Required for automated PRs and webhook handling)
# Found in GitHub Settings -> Developer settings -> GitHub Apps -> Your App
GITHUB_APP_ID=
GITHUB_APP_SLUG=open-workers
GITHUB_WEBHOOK_SECRET=

# Provide EITHER a file path to your downloaded PEM key OR the inline PEM string
# (with literal \n newlines). Do not commit the .pem file.
GITHUB_PRIVATE_KEY_PATH=
GITHUB_PRIVATE_KEY=

# Optional: Public GitHub API token (only used as fallback if App auth isn't
# active and unauthenticated 60 req/hr rate limit is exceeded during local dev)
GITHUB_PUBLIC_TOKEN=

# Optional: Smee.io webhook proxy URL for local webhook development
# See docs/DEVELOPMENT.md for setup instructions
WEBHOOK_PROXY_URL=

